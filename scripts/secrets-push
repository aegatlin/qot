#!/usr/bin/env bash
# Copy one fnox profile's secrets to the Railway `server` service in the
# environment of the same name, then redeploy it. fnox.toml is the source of
# truth; Railway holds the deployed copy. Values travel over stdin only.
#
#   scripts/secrets-push staging
set -euo pipefail

env="${1:?usage: secrets-push <staging|production>}"
case "$env" in staging | production) ;; *) echo "unknown environment: $env" >&2; exit 2 ;; esac

project=c0b0971f-f47e-4c78-8777-65a7c41142db
secrets_json="$(fnox -P "$env" export --format json)"
keys="$(python3 -I -c 'import json,sys; print("\n".join(sorted(json.load(sys.stdin)["secrets"])))' <<<"$secrets_json")"

for key in $keys; do
  python3 -I -c 'import json,sys; sys.stdout.write(json.load(sys.stdin)["secrets"][sys.argv[1]])' "$key" <<<"$secrets_json" |
    railway variable set "$key" --stdin --project "$project" --environment "$env" --service server --skip-deploys >/dev/null
  echo "set $key"
done

railway redeploy --project "$project" --environment "$env" --service server --yes
