---
// One shell command, ready to copy by hand (the site has no JavaScript, so
// no copy button).
interface Props {
  command: string;
}
const { command } = Astro.props;
---

<pre
  class="overflow-x-auto rounded-lg border bg-code px-4 py-3 font-mono text-sm leading-relaxed"><code><span class="select-none text-muted-foreground">$ </span>{command}</code></pre>
