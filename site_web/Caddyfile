# The website's server: static files from /srv, plus /health. Environment
# from bin/site: PORT, COMMIT. TLS ends at Railway's edge, so Caddy serves
# plain HTTP.
{
	admin off
	auto_https off
	persist_config off
}

:{$PORT} {
	root * /srv
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# Plain HTML and CSS from this origin; the only script is Plausible's,
		# proxied below, so it is this origin too.
		Content-Security-Policy "default-src 'none'; script-src 'self'; connect-src 'self'; style-src 'self'; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		-Server
	}

	# Built files are named by their content.
	@immutable path /_astro/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# Everything else must be revalidated, or a new build wouldn't show.
	@fresh not path /_astro/*
	header @fresh Cache-Control "no-cache"

	handle /health {
		header Content-Type application/json
		respond `{"status":"ok","commit":"{$COMMIT}"}` 200
	}

	# Plausible page views, proxied so nothing loads from another origin and
	# blockers of plausible.io don't skew the counts. Plausible tells visitors
	# apart by IP, so send the client's (Railway's edge sets X-Real-IP).
	handle /js/script.js {
		reverse_proxy https://plausible.io {
			header_up Host {upstream_hostport}
			header_up -Cookie
		}
	}
	# Only production counts; elsewhere (staging, local, CI) events stop here.
	@count {
		path /api/event
		host www.quantumofthought.com
	}
	handle @count {
		reverse_proxy https://plausible.io {
			header_up Host {upstream_hostport}
			header_up -Cookie
			header_up X-Forwarded-For {header.X-Real-IP}
		}
	}
	handle /api/event {
		respond 202
	}

	# /privacy.html is linked as /privacy; send the long form there.
	redir /index.html / 308
	@html path_regexp html ^(/.+)\.html$
	redir @html {re.html.1} 308
	@slash path_regexp slash ^(/.+)/$
	redir @slash {re.slash.1} 308

	handle {
		try_files {path} {path}.html
		file_server
	}

	handle_errors 404 {
		rewrite * /404.html
		file_server
	}
}
